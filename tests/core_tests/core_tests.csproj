<Project Sdk="Microsoft.NET.Sdk">

  <!--
    core_tests —— native/src/core 共享核心的单元测试（无外部测试框架，直接运行）。
    与 dst_server_cs 同为 net472，保证测试看到的就是服务器编译进去的语义。
    运行：dotnet build -c Release tests\core_tests 后执行 tests\core_tests\bin\Release\net472\dst_core_tests.exe（退出码 0 = 全部通过）
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dst_core_tests</AssemblyName>
    <RootNamespace>DstCoreTests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\native\src\core\*.cs" Link="core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
